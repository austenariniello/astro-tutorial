---
const { frontmatter } = Astro.props;
---
<meta charset="utf-8" />
<h1>{frontmatter.title}</h1>
<p>Written by {frontmatter.author}. Published on: {frontmatter.pubDate.toString().slice(0,10)}.</p>
<p><em>{frontmatter.description}</em></p>
<img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />
<slot />
{frontmatter.tags && <p>Tags: <em>{frontmatter.tags.join(", ")}</em></p>}